---
/**
 * The Story: stage one of the redesign, for Wasif to see before the rest is
 * built. Wasif now, the prologue, and chapter 01. Not linked from the live
 * site, and noindex.
 */
import StoryLayout from '../layouts/StoryLayout.astro';
import Loader from '../components/story/Loader.astro';
import Hero from '../components/story/Hero.astro';
import FlightScene from '../components/story/FlightScene.astro';
import YearRail from '../components/story/YearRail.astro';
---

<StoryLayout title="Wasif Karim" description="Wasif Karim, robotics software engineer. The story from Dhaka in 2022 to Cleveland now.">
  <script is:inline>
    if (!matchMedia('(prefers-reduced-motion: reduce)').matches) document.documentElement.classList.add('js-motion');
  </script>
  <Loader />
  <YearRail />
  <main>
    <Hero />
    <FlightScene />
    <p class="proto mono">Stage one · more chapters next</p>
  </main>
</StoryLayout>

<style>
  .proto { margin: 0; padding: 3rem var(--gutter); color: var(--dim); }
</style>

<script>
  import { gsap, ScrollTrigger, initMotion } from '../lib/motion';

  const motion = initMotion();
  const loader = document.querySelector<HTMLElement>('[data-loader]');

  if (!motion) {
    loader?.remove();
  } else {
    // 1. Loader: the years roll to now, then lift away.
    const reel = document.querySelector('[data-reel]');
    const photo = document.querySelector<HTMLImageElement>('.hero__layer');
    const ready = new Promise<void>((resolve) => {
      const done = () => resolve();
      if (!photo || photo.complete) done();
      else { photo.addEventListener('load', done, { once: true }); photo.addEventListener('error', done, { once: true }); }
      setTimeout(done, 3200);
    });
    const minimum = new Promise((r) => setTimeout(r, 2400));

    // Rows are 1.1em, so moving (rows - 1) of them stops the reel square on 2026.
    // It rushes through the years and slows as it reaches now.
    const rows = Number((reel as HTMLElement | null)?.dataset.rows ?? 1);
    gsap.to(reel, { y: `-${((rows - 1) * 1.1).toFixed(1)}em`, duration: 2.2, ease: 'expo.inOut' });
    gsap.set('[data-fade]', { autoAlpha: 0 });
    gsap.set('[data-hero-scene]', { scale: 1.08 });

    Promise.all([ready, minimum]).then(() => {
      gsap.timeline()
        .to(loader, { yPercent: -100, duration: 1.1, ease: 'power4.inOut' })
        .to('[data-hero-scene]', { scale: 1, duration: 2.2, ease: 'power3.out' }, 0.3)
        .to('[data-fade]', { autoAlpha: 1, duration: 0.9, ease: 'power2.out' }, 1.0)
        .add(() => {
          loader?.remove();
          // The name's dots settle now (src/components/story/Hero.astro).
          document.dispatchEvent(new CustomEvent('story:reveal'));
        }, 0.45);
    });

    // 2. Hero: the scene settles back as it darkens; the name's dots leave on
    //    their own (Hero.astro), flying toward where the globe gathers.
    gsap.timeline({ scrollTrigger: { trigger: '[data-hero]', start: 'top top', end: 'bottom bottom', scrub: 0.8 } })
      .to('[data-hero-scene]', { scale: 1.06, duration: 1, ease: 'none' }, 0)
      .to('[data-hero-dim]', { opacity: 1, duration: 0.45, ease: 'none' }, 0.55);

    // 5. The year rail: on once the story begins, the current year lit.
    const rail = document.querySelector('[data-rail]');
    // Each scene lights its own year as it reaches it (see FlightScene).
    ScrollTrigger.create({
      trigger: '#flight',
      start: 'top 60%',
      onEnter: () => rail?.classList.add('is-on'),
      onLeaveBack: () => rail?.classList.remove('is-on'),
    });
  }
</script>
