---
import BaseLayout from '../layouts/BaseLayout.astro';
import SceneContact from '../components/scenes/SceneContact.astro';
---

<BaseLayout title="Contact" description="Get in touch with Wasif Karim.">
  <div class="sheet page">
    <p class="label">FIG. 16</p>
    <h1>Contact</h1>
    <SceneContact idPrefix="page" />
  </div>
</BaseLayout>

<style>
  .page {
    padding-block: var(--space-3xl) var(--space-2xl);
  }

  h1 {
    font-size: var(--step-5);
    margin-block: var(--space-2xs) var(--space-l);
  }
</style>
