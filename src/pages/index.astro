---
import BaseLayout from '../layouts/BaseLayout.astro';
import SceneSection from '../components/SceneSection.astro';
import CloudStage from '../components/CloudStage.astro';
import SceneBoot from '../components/scenes/SceneBoot.astro';
import SceneNow from '../components/scenes/SceneNow.astro';
import SceneFlight from '../components/scenes/SceneFlight.astro';
import SceneRewind from '../components/scenes/SceneRewind.astro';
import SceneRoboticsClub from '../components/scenes/SceneRoboticsClub.astro';
import SceneParallelTracks from '../components/scenes/SceneParallelTracks.astro';
import SceneResume from '../components/scenes/SceneResume.astro';
import SceneWorkFlight from '../components/scenes/SceneWorkFlight.astro';
import SceneAccepted from '../components/scenes/SceneAccepted.astro';
import SceneCampus from '../components/scenes/SceneCampus.astro';
import SceneGraduation from '../components/scenes/SceneGraduation.astro';
import SceneThinkbox from '../components/scenes/SceneThinkbox.astro';
import SceneLeland from '../components/scenes/SceneLeland.astro';
import SceneHilton from '../components/scenes/SceneHilton.astro';
import SceneAirbnb from '../components/scenes/SceneAirbnb.astro';
import SceneContact from '../components/scenes/SceneContact.astro';
import { scenes } from '../data/scenes';

/**
 * The scroll story, FIG. 00 through FIG. 16.
 *
 * Scenes come from the registry in src/data/scenes.ts. A built scene supplies a
 * component below; the rest are rendered with no body, so <SceneSection> falls
 * back to the summary and what the scene is waiting on. That keeps the whole
 * spine walkable while media is still being shot.
 *
 * FIG. 00 is the exception — it is the loading overlay, not a scroll section.
 */
const sections = scenes.filter((scene) => scene.presentation !== 'overlay');
---

<BaseLayout title="Wasif Karim">
  <SceneBoot />
  <CloudStage />

  {
    sections.map((scene) => {
      // Passing an empty expression would count as filling the slot and
      // suppress the fallback, so built scenes branch explicitly.
      if (scene.slug === 'now') {
        return (
          <SceneSection scene={scene}>
            <SceneNow />
          </SceneSection>
        );
      }
      if (scene.slug === 'rewind') {
        return (
          <SceneSection scene={scene}>
            <SceneRewind />
          </SceneSection>
        );
      }
      if (scene.slug === 'flight') {
        return (
          <SceneSection scene={scene}>
            <SceneFlight />
          </SceneSection>
        );
      }
      if (scene.slug === 'robotics-club') {
        return (
          <SceneSection scene={scene}>
            <SceneRoboticsClub />
          </SceneSection>
        );
      }
      if (scene.slug === 'leland') {
        return (
          <SceneSection scene={scene}>
            <SceneLeland />
          </SceneSection>
        );
      }
      if (scene.slug === 'hilton') {
        return (
          <SceneSection scene={scene}>
            <SceneHilton />
          </SceneSection>
        );
      }
      if (scene.slug === 'airbnb') {
        return (
          <SceneSection scene={scene}>
            <SceneAirbnb />
          </SceneSection>
        );
      }
      if (scene.slug === 'parallel-tracks') {
        return (
          <SceneSection scene={scene}>
            <SceneParallelTracks />
          </SceneSection>
        );
      }
      if (scene.slug === 'accepted') {
        return (
          <SceneSection scene={scene}>
            <SceneAccepted />
          </SceneSection>
        );
      }
      if (scene.slug === 'ohio-wesleyan') {
        return (
          <SceneSection scene={scene}>
            <SceneCampus />
          </SceneSection>
        );
      }
      if (scene.slug === 'graduation') {
        return (
          <SceneSection scene={scene}>
            <SceneGraduation />
          </SceneSection>
        );
      }
      if (scene.slug === 'thinkbox') {
        return (
          <SceneSection scene={scene}>
            <SceneThinkbox />
          </SceneSection>
        );
      }
      if (scene.slug === 'work') {
        return (
          <SceneSection scene={scene}>
            <SceneWorkFlight />
          </SceneSection>
        );
      }
      if (scene.slug === 'resume') {
        return (
          <SceneSection scene={scene}>
            <SceneResume />
          </SceneSection>
        );
      }
      if (scene.slug === 'contact') {
        return (
          <SceneSection scene={scene}>
            <SceneContact idPrefix="story" />
          </SceneSection>
        );
      }
      return <SceneSection scene={scene} />;
    })
  }
</BaseLayout>

<script>
  import { initMotion } from '../lib/motion';

  // Boots GSAP + Lenis, or does nothing under prefers-reduced-motion.
  initMotion();
</script>
