---
/**
 * The opening beat: the years roll from 2004, the year Wasif was born, to 2026,
 * slowing as they reach now, then lift away to reveal him. It only runs with
 * motion, and never holds the page past the photo's arrival (2.4 s at least,
 * 3.2 s at most).
 */
const first = 2004;
const last = 2026;
const years = Array.from({ length: last - first + 1 }, (_, i) => first + i);
---

<div class="loader" data-loader aria-hidden="true">
  <div class="loader__years">
    <div class="loader__reel" data-reel data-rows={years.length}>
      {years.map((year) => <span>{year}</span>)}
    </div>
  </div>
  <p class="mono loader__caption">Wasif Karim · the story so far</p>
</div>

<style>
  .loader {
    position: fixed;
    inset: 0;
    z-index: 50;
    display: none;
    place-content: center;
    justify-items: center;
    gap: 1.2rem;
    background: var(--night);
  }

  :global(html.js-motion) .loader { display: grid; }

  .loader__years {
    height: 1.1em;
    overflow: hidden;
    clip-path: inset(0);
    font: 800 clamp(4rem, 12vw, 9rem)/1.1 var(--display);
    letter-spacing: 0.01em;
    font-variant-numeric: tabular-nums;
  }

  .loader__reel { display: grid; }
  .loader__reel span { display: block; height: 1.1em; }

  .loader__caption { margin: 0; color: var(--silver); }
</style>
