---
/**
 * Chapter 03: the first summer in the US, and the first job writing software.
 *
 * The car lets go and the same dots set two words, on the stage the whole story
 * is drawn on (src/lib/story-stage.ts). The storyboard asks for an initial
 * commit here; this is that idea set as type rather than a mocked-up terminal,
 * and it invents no commit, hash or transcript. The facts are from
 * src/data/scenes.ts: Software Development Intern, Leland, summer 2023.
 *
 * Without motion the words are simply the heading, and the chapter reads as text.
 */
---

<section class="ls" id="leland" data-leland aria-labelledby="ls-title">
  <div class="ls__pin">
    <p class="ls__word" data-word aria-hidden="true">git init</p>

    <div class="ls__readout" data-readout>
      <p class="mono ls__where">Leland · Summer 2023</p>
      <p class="mono ls__role">Software Development Intern</p>
    </div>

    <div class="ls__chapter" data-chapter-text>
      <p class="mono ls__meta">Chapter 03 · 2023</p>
      <h2 class="ls__title" id="ls-title">The first summer here, <em>and the first job writing software.</em></h2>
    </div>
  </div>
</section>

<style>
  .ls { position: relative; }

  :global(html.js-motion) .ls { height: 320svh; }

  .ls__pin {
    position: relative;
    overflow: hidden;
    background: var(--night);
  }

  :global(html.js-motion) .ls__pin { position: sticky; top: 0; height: 100svh; min-height: 36rem; background: transparent; }

  /* With motion the dots set these words; the text stands down to the reader. */
  .ls__word {
    margin: 0;
    padding: 4rem var(--gutter) 0;
    font: 850 min(13vw, 24svh)/1 var(--display);
    letter-spacing: -0.005em;
    text-transform: uppercase;
    text-align: center;
    color: var(--paper);
  }
  :global(html.js-motion) .ls__word { display: none; }

  .ls__readout { display: grid; gap: 0.35rem; margin: 2rem var(--gutter) 0; }
  :global(html.js-motion) .ls__readout { position: absolute; right: calc(var(--gutter) + 6rem); top: 2.25rem; z-index: 3; margin: 0; text-align: right; opacity: 0; }
  .ls__readout p { margin: 0; }
  .ls__where { color: var(--flight); }
  .ls__role { color: var(--dim); }

  .ls__chapter { position: relative; z-index: 3; display: grid; gap: 0.9rem; padding: 2rem var(--gutter) 4rem; }
  :global(html.js-motion) .ls__chapter {
    position: absolute;
    left: var(--gutter);
    bottom: clamp(2rem, 8svh, 5rem);
    width: min(52%, 38rem);
    padding: 0;
    opacity: 0;
  }
  .ls__meta { margin: 0; color: var(--silver); }
  .ls__title { margin: 0; font: 400 clamp(2.2rem, 1.3rem + 2.6vw, 3.8rem)/1 var(--serif); letter-spacing: -0.015em; text-wrap: balance; }
  .ls__title em { color: var(--silver); }

  @media (max-width: 59.99rem) {
    :global(html.js-motion) .ls__readout { right: var(--gutter); }
    :global(html.js-motion) .ls__chapter { width: auto; right: var(--gutter); }
  }
</style>

<script>
  import { ScrollTrigger, initMotion } from '../../lib/motion';
  import { openStage, setStage } from '../../lib/story-stage';

  const root = document.querySelector<HTMLElement>('[data-leland]');
  const readout = root?.querySelector<HTMLElement>('[data-readout]') ?? null;
  const chapter = root?.querySelector<HTMLElement>('[data-chapter-text]') ?? null;

  const clamp = (v: number) => Math.min(Math.max(v, 0), 1);
  const span = (p: number, a: number, b: number) => clamp((p - a) / (b - a));
  const smooth = (t: number) => t * t * (3 - 2 * t);

  if (root && readout && chapter && initMotion()) {
    openStage();

    const apply = (p: number) => {
      // As in the chapter before: only once this scene is actually moving, or
      // it would write its own opening state over the stage on page load.
      if (p > 0.001) {
        setStage({
          enter: 1,
          scatter: 1,
          assemble: 1,
          flight: 1,
          morph: 1,
          fade: 0,
          machine: 1,
          word: smooth(span(p, 0.08, 0.45)),
        });
      }
      readout.style.opacity = String(smooth(span(p, 0.4, 0.52)));
      const title = smooth(span(p, 0.55, 0.68));
      chapter.style.opacity = String(title);
      chapter.style.transform = `translateY(${(1 - title) * 24}px)`;
    };

    ScrollTrigger.create({ trigger: root, start: 'top top', end: 'bottom bottom', onUpdate: (self) => apply(self.progress) });
    apply(0);
  }
</script>
