---
/**
 * Chapter 03: where he has worked.
 *
 * Five places, one segment. The dots carry from one name to the next rather
 * than dropping one and gathering another, and the list beside them arrives a
 * row at a time and accumulates.
 *
 * Everything before this chapter is dimensional — a graded photograph, a globe
 * with a rim light, a machine. Flat type on flat black read as a slide dropped
 * into the middle of it, so the words here stand in depth, lean toward the
 * pointer, breathe where they stand, and run warm while they are crossing.
 *
 * The names are set as type, not as logos: shipping other companies' marks is
 * forbidden by CLAUDE.md, invites a trademark complaint, and would put five
 * brand palettes into a black-and-white story. Roles and dates are the ones his
 * own files record; nothing here describes what he built, by request.
 */
const places = [
  { name: 'Leland', role: 'Software Development Intern', when: 'Summer 2023', year: '2023' },
  { name: 'Hilton', role: 'Software Engineering Intern', when: 'Summer 2024', year: '2024' },
  { name: 'Airbnb', role: 'Software Engineering Intern', when: 'Summer 2025', year: '2025' },
  { name: 'think[box]', role: 'Robotics Software Engineer · Case Western Reserve', when: '2026', year: '2026' },
  { name: 'OpsiClear', role: 'AI Research Engineer · Cleveland', when: 'Now', year: '2026' },
];
---

<section class="xp" id="experience" data-experience aria-labelledby="xp-title">
  <div class="xp__pin">
    <p class="xp__count" data-count aria-hidden="true">01</p>

    <div class="xp__side">
      <p class="mono xp__meta">Chapter 03 · 2023 – now</p>
      <h2 class="xp__title" id="xp-title">Five places, <em>five summers and a job.</em></h2>
      <span class="xp__rule" aria-hidden="true"><i data-rule></i></span>

      <ol class="xp__list">
        {
          places.map((place, index) => (
            <li class="xp__row" data-row={index} data-year={place.year}>
              <span class="xp__name">{place.name}</span>
              <span class="mono xp__when">{place.when}</span>
              <span class="mono xp__role">{place.role}</span>
            </li>
          ))
        }
      </ol>
    </div>
  </div>
</section>

<style>
  .xp { position: relative; }

  :global(html.js-motion) .xp { height: 600svh; }

  .xp__pin { position: relative; overflow: hidden; background: var(--night); }
  :global(html.js-motion) .xp__pin { position: sticky; top: 0; height: 100svh; min-height: 36rem; background: transparent; }

  /* A pool of light for the words to stand in, so they are not on a void. */
  :global(html.js-motion) .xp__pin::before {
    content: '';
    position: absolute;
    inset: 0;
    z-index: 1;
    pointer-events: none;
    background: radial-gradient(52% 40% at 64% 46%, rgb(233 207 166 / 0.07), rgb(243 242 238 / 0.03) 42%, transparent 72%);
  }

  /* Which of the five you are on, set like a plate number. */
  .xp__count { display: none; }
  :global(html.js-motion) .xp__count {
    position: absolute;
    right: calc(var(--gutter) + 5rem);
    top: 6%;
    z-index: 2;
    display: block;
    margin: 0;
    font: 850 min(15vw, 22svh)/1 var(--display);
    letter-spacing: -0.02em;
    color: transparent;
    -webkit-text-stroke: 1px rgb(243 242 238 / 0.2);
    font-variant-numeric: tabular-nums;
  }

  .xp__side { padding: 3rem var(--gutter) 4rem; }
  :global(html.js-motion) .xp__side {
    position: absolute;
    left: var(--gutter);
    top: 50%;
    z-index: 3;
    width: min(42%, 29rem);
    padding: 0;
    translate: 0 -50%;
  }

  .xp__meta { margin: 0 0 0.7rem; color: var(--silver); }
  .xp__title { margin: 0; font: 400 clamp(1.8rem, 1.2rem + 1.8vw, 2.6rem)/1.05 var(--serif); letter-spacing: -0.015em; text-wrap: balance; }
  .xp__title em { color: var(--silver); }

  /* How far through the five you are. */
  .xp__rule { display: none; }
  :global(html.js-motion) .xp__rule {
    display: block;
    height: 1px;
    margin-block: 1.7rem;
    background: rgb(243 242 238 / 0.14);
  }
  .xp__rule i { display: block; height: 100%; background: var(--flight); transform-origin: 0 50%; transform: scaleX(0); }

  .xp__list { margin: 0; padding: 0; list-style: none; display: grid; gap: 1.25rem; }

  .xp__row {
    position: relative;
    display: grid;
    grid-template-columns: 1fr auto;
    gap: 0.3rem 1rem;
    padding-inline-start: 1.1rem;
  }

  /* A mark against the place you are on. */
  .xp__row::before {
    content: '';
    position: absolute;
    left: 0;
    top: 0.35em;
    width: 2px;
    height: 0;
    background: var(--flight);
    transition: height 600ms var(--ease-out);
  }
  .xp__row.is-here::before { height: 1.1em; }

  /* With motion each row arrives as you reach it, and the five accumulate. */
  :global(html.js-motion) .xp__row {
    opacity: 0;
    translate: 0 14px;
    transition: opacity 800ms var(--ease-out), translate 800ms var(--ease-out);
  }
  :global(html.js-motion) .xp__row.is-in { opacity: 0.34; translate: 0 0; }
  :global(html.js-motion) .xp__row.is-here { opacity: 1; }

  .xp__name {
    font: 400 clamp(1.3rem, 1.1rem + 0.7vw, 1.75rem)/1.15 var(--serif);
    letter-spacing: -0.01em;
    color: var(--paper);
  }
  .xp__when {
    grid-column: 2;
    grid-row: 1;
    align-self: baseline;
    font-size: 0.72rem;
    letter-spacing: 0.07em;
    color: var(--dim);
    font-variant-numeric: tabular-nums;
    transition: color 600ms var(--ease-out);
  }
  .xp__row.is-here .xp__when { color: var(--flight); }
  .xp__role {
    grid-column: 1 / -1;
    max-width: 32ch;
    font-size: 0.7rem;
    line-height: 1.6;
    letter-spacing: 0.07em;
    text-transform: uppercase;
    color: var(--dim);
  }

  @media (max-width: 59.99rem) {
    :global(html.js-motion) .xp__pin::before { background: radial-gradient(60% 26% at 50% 34%, rgb(233 207 166 / 0.08), transparent 70%); }
    :global(html.js-motion) .xp__count { right: var(--gutter); top: 4%; font-size: min(22vw, 14svh); }
    :global(html.js-motion) .xp__side { width: auto; right: var(--gutter); top: auto; bottom: clamp(1.5rem, 5svh, 3rem); translate: 0 0; }
    :global(html.js-motion) .xp__list { gap: 0.8rem; }
    .xp__role { display: none; }
    :global(html.js-motion) .xp__row.is-here .xp__role { display: block; }
  }
</style>

<script>
  import { ScrollTrigger, initMotion } from '../../lib/motion';
  import { openStage, setStage, selectStagePlaces, tiltStage, enliven } from '../../lib/story-stage';

  const root = document.querySelector<HTMLElement>('[data-experience]');
  const count = root?.querySelector<HTMLElement>('[data-count]') ?? null;
  const rule = root?.querySelector<HTMLElement>('[data-rule]') ?? null;
  const rows = [...(root?.querySelectorAll<HTMLElement>('[data-row]') ?? [])];

  const clamp = (v: number) => Math.min(Math.max(v, 0), 1);
  const span = (p: number, a: number, b: number) => clamp((p - a) / (b - a));
  const smooth = (t: number) => t * t * (3 - 2 * t);

  if (root && count && rule && rows.length && initMotion()) {
    const total = rows.length;
    let pair = '';
    let here = -1;
    let last = 0;

    const apply = (p: number) => {
      last = p;
      const t = p * total;
      const slot = Math.min(Math.floor(t), total - 1);
      const next = Math.min(slot + 1, total - 1);
      const local = t - slot;
      // Each name is held, then carried into the one after it. The last place
      // has nothing to cross to, so it simply stays itself.
      const blend = next === slot ? 0 : smooth(span(local, 0.62, 0.95));

      const key = `${slot}:${next}`;
      if (key !== pair) {
        pair = key;
        selectStagePlaces(slot, next);
      }

      setStage({
        enter: 1, scatter: 1, assemble: 1, flight: 1, morph: 1,
        fade: 0, machine: 1,
        // The dots gather the first name as the chapter opens, then stay in words.
        word: smooth(span(p, 0.008, 0.07)),
        wordBlend: blend,
      });

      rule.style.transform = `scaleX(${p.toFixed(4)})`;

      // Once the dots are more than halfway across, the next place is the one
      // being read, so the list and the number turn over with them.
      const current = blend > 0.5 ? next : slot;
      if (current !== here) {
        here = current;
        count.textContent = String(current + 1).padStart(2, '0');
        rows.forEach((row, i) => {
          row.classList.toggle('is-in', i <= current);
          row.classList.toggle('is-here', i === current);
        });
        const year = rows[current]?.dataset.year;
        for (const el of document.querySelectorAll('[data-rail-year]')) {
          el.classList.toggle('is-current', (el as HTMLElement).dataset.railYear === year);
        }
      }
    };

    ScrollTrigger.create({ trigger: root, start: 'top top', end: 'bottom bottom', onUpdate: (self) => apply(self.progress) });

    // The words only breathe and follow the pointer while this chapter is on
    // screen; everywhere else the stage still draws once per scroll.
    ScrollTrigger.create({
      trigger: root,
      start: 'top bottom',
      end: 'bottom top',
      onToggle: (self) => enliven(self.isActive),
    });

    window.addEventListener('pointermove', (event) => {
      tiltStage((event.clientX / window.innerWidth - 0.5) * 2, (event.clientY / window.innerHeight - 0.5) * 2);
    }, { passive: true });

    apply(0);
    // The names are sampled when the stage opens; put the right pair up then.
    openStage().then(() => { pair = ''; here = -1; apply(last); });
  }
</script>
