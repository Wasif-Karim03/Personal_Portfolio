---
/**
 * Chapter 02: the club he founded, and the machine he built.
 *
 * The dots let University Hall go and stream into his autonomous car, on the
 * same fixed stage the name and the globe were drawn on (src/lib/story-stage.ts).
 * The car is sampled from his own photograph of it, inverted — it is a black car
 * on a pale floor, and inverted it reads as a lit machine in the dark, which is
 * also the only way the dot sampler spends its points on the car and not on the
 * floor.
 *
 * Two separate facts, kept separate: the club is 2023, the car is 2025. The
 * chapter text is the club; the readout names the machine and its own year.
 * Numbers are from docs/storyboard.md.
 *
 * Without motion or WebGL the scene is laid out still: the picture, the counts,
 * and the chapter.
 */
import { Picture } from 'astro:assets';
import machine from '../../assets/story/machine.jpg';
---

<section class="ms" id="club" data-machine-scene aria-labelledby="ms-title">
  <div class="ms__pin">
    <div class="ms__still">
      <Picture src={machine} formats={['avif', 'webp']} widths={[960, 1600, 2400]} sizes="100vw" alt="Wasif's autonomous RC car, shown as a photographic negative: a black chassis with knobbly tyres, a LiDAR puck and an SE100 GNSS unit at the front, a Jetson Orin Nano with a clear cooling fan and a Raspberry Pi with a camera on the deck, and a roll cage at the back." class="ms__img" />
    </div>

    <div class="ms__readout" data-readout>
      <p class="mono ms__machine">My autonomous car · 2025</p>
      <p class="mono ms__spec">ROS 2 Humble · Jetson Orin Nano</p>
    </div>

    <dl class="ms__counts" data-counts>
      <div>
        <dt class="mono">Members</dt>
        <dd data-count data-to="267">267</dd>
      </div>
      <div>
        <dt class="mono">Raised</dt>
        <dd data-count data-to="68" data-prefix="$" data-suffix="K">$68K</dd>
      </div>
    </dl>

    <div class="ms__chapter" data-chapter-text>
      <p class="mono ms__meta">Chapter 02 · Ohio Wesleyan · 2023</p>
      <h2 class="ms__title" id="ms-title">A robotics club, <em>from nothing.</em></h2>
      <p class="ms__sub">Founding President. The club came first; the car came later.</p>
    </div>
  </div>
</section>

<style>
  .ms { position: relative; }

  :global(html.js-motion) .ms { height: 420svh; }

  .ms__pin {
    position: relative;
    overflow: hidden;
    background: var(--night);
  }

  /* With motion the dots are on the fixed stage behind the page, so the pin
     must not paint over it, and the still stands down. */
  :global(html.js-motion) .ms__pin { position: sticky; top: 0; height: 100svh; min-height: 36rem; background: transparent; }
  :global(html.js-motion) .ms__still { display: none; }

  .ms__still { position: relative; aspect-ratio: 16 / 9; }
  .ms__still :global(picture) { display: contents; }
  .ms__still :global(.ms__img) { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; }

  .ms__readout { display: grid; gap: 0.35rem; margin: 2rem var(--gutter) 0; }
  :global(html.js-motion) .ms__readout { position: absolute; right: calc(var(--gutter) + 6rem); top: 2.25rem; z-index: 3; margin: 0; text-align: right; opacity: 0; }
  .ms__readout p { margin: 0; }
  .ms__machine { color: var(--flight); }
  .ms__spec { color: var(--dim); }

  .ms__counts {
    display: flex;
    gap: clamp(1.5rem, 5vw, 3rem);
    margin: 2rem var(--gutter);
  }
  :global(html.js-motion) .ms__counts {
    position: absolute;
    left: var(--gutter);
    top: 24%;
    z-index: 3;
    width: min(40%, 24rem);
    margin: 0;
    opacity: 0;
  }
  .ms__counts > div { display: grid; gap: 0.3rem; }
  .ms__counts dt { color: var(--silver); }
  .ms__counts dd {
    margin: 0;
    font: 850 clamp(2.2rem, 1.2rem + 2.6vw, 3.6rem)/0.9 var(--display);
    letter-spacing: -0.01em;
    font-variant-numeric: tabular-nums;
    color: var(--paper);
  }

  .ms__chapter { position: relative; z-index: 3; display: grid; gap: 0.9rem; max-width: 46rem; padding: 0 var(--gutter) 4rem; }
  :global(html.js-motion) .ms__chapter {
    position: absolute;
    left: var(--gutter);
    bottom: clamp(2rem, 8svh, 5rem);
    width: min(40%, 30rem);
    max-width: none;
    padding: 0;
    opacity: 0;
  }
  .ms__meta { margin: 0; color: var(--silver); }
  .ms__title { margin: 0; font: 400 clamp(2.2rem, 1.3rem + 2.6vw, 3.8rem)/1 var(--serif); letter-spacing: -0.015em; text-wrap: balance; }
  .ms__title em { color: var(--silver); }
  .ms__sub { margin: 0; font-size: clamp(0.98rem, 0.93rem + 0.25vw, 1.1rem); color: var(--silver); }

  /* Narrow: the machine sits up top, the words stack underneath it. */
  @media (max-width: 59.99rem) {
    :global(html.js-motion) .ms__readout { right: var(--gutter); }
    :global(html.js-motion) .ms__counts { top: auto; bottom: 34svh; width: auto; right: var(--gutter); }
    :global(html.js-motion) .ms__chapter { width: auto; right: var(--gutter); }
  }
</style>

<script>
  import { ScrollTrigger, initMotion } from '../../lib/motion';
  import { openStage, setStage } from '../../lib/story-stage';

  const root = document.querySelector<HTMLElement>('[data-machine-scene]');
  const q = <T extends HTMLElement>(s: string) => root?.querySelector<T>(s) ?? null;
  const readout = q('[data-readout]');
  const counts = q('[data-counts]');
  const chapter = q('[data-chapter-text]');
  const numbers = [...(root?.querySelectorAll<HTMLElement>('[data-count]') ?? [])];

  const clamp = (v: number) => Math.min(Math.max(v, 0), 1);
  const span = (p: number, a: number, b: number) => clamp((p - a) / (b - a));
  const smooth = (t: number) => t * t * (3 - 2 * t);

  if (root && readout && counts && chapter && initMotion()) {
    openStage();

    const apply = (p: number) => {
      // Only once this scene is actually moving. At its own progress 0 the dots
      // are meant to be hidden, and saying so on page load would hide the name
      // on the first screen — this stage is shared with every other chapter.
      if (p > 0.001) {
        setStage({
          enter: 1,
          scatter: 1,
          assemble: 1,
          flight: 1,
          morph: 1,
          // The hall lets the dots go, they build the car, and it holds.
          fade: 1 - smooth(span(p, 0.02, 0.13)),
          machine: smooth(span(p, 0.15, 0.5)),
        });
      }

      readout.style.opacity = String(smooth(span(p, 0.42, 0.54)));

      const rolling = smooth(span(p, 0.5, 0.68));
      counts.style.opacity = String(rolling);
      for (const el of numbers) {
        const to = Number(el.dataset.to);
        const value = Math.round(to * rolling);
        el.textContent = `${el.dataset.prefix ?? ''}${value.toLocaleString('en-US')}${el.dataset.suffix ?? ''}`;
      }

      const title = smooth(span(p, 0.72, 0.84));
      chapter.style.opacity = String(title);
      chapter.style.transform = `translateY(${(1 - title) * 24}px)`;

      // One year is lit at a time: this chapter takes 2023 from the flight's 2022.
      const here = p > 0.5;
      document.querySelector('[data-rail-year="2023"]')?.classList.toggle('is-current', here);
      document.querySelector('[data-rail-year="2022"]')?.classList.toggle('is-current', !here);
    };

    ScrollTrigger.create({ trigger: root, start: 'top top', end: 'bottom bottom', onUpdate: (self) => apply(self.progress) });
    apply(0);
  }
</script>
