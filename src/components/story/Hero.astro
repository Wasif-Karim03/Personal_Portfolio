---
/**
 * Wasif, now: a real photo of him (New York, May 2026) in black and white, with
 * his name set huge behind him. Three layers share one frame: the photo, the
 * name, then Wasif cut from the photo with its matte, so the name passes behind
 * his head. Nothing here is generated; the cut-out comes from the photo itself.
 *
 * With motion, the name rises in once the page is ready, and on scroll it
 * drifts at a different depth from him before the scene darkens into the story.
 */
import { Picture } from 'astro:assets';
import now from '../../assets/story/now.jpg';
import cutout from '../../assets/story/now-cutout.png';
---

<section class="hero" data-hero aria-labelledby="hero-name">
  <div class="hero__pin" data-hero-pin>
    <div class="hero__scene" data-hero-scene>
      <Picture src={now} formats={['avif', 'webp']} widths={[900, 1400, 1800]} sizes="100vw" loading="eager" fetchpriority="high" alt="" class="hero__layer" />
      <h1 class="hero__name" id="hero-name" data-hero-name>
        <span class="hero__word"><span data-rise>Wasif</span></span>
        <span class="hero__word"><span data-rise>Karim</span></span>
      </h1>
      <Picture src={cutout} formats={['avif', 'webp']} widths={[900, 1400, 1800]} sizes="100vw" loading="eager" alt="Wasif Karim smiling in a denim jacket on a rooftop in New York, black and white." class="hero__layer hero__cut" />
    </div>

    <header class="hero__top" data-fade>
      <p class="mono">Portfolio · 2026</p>
      <nav class="hero__nav" aria-label="Main">
        <a href="/work">Work</a>
        <a href="/contact">Contact</a>
      </nav>
    </header>

    <div class="hero__foot" data-fade>
      <p class="mono hero__role">Robotics software engineer<br />Cleveland, Ohio</p>
      <a class="mono hero__cue" href="#prelude">The story, 2022 → now <span aria-hidden="true">↓</span></a>
    </div>

    <div class="hero__dim" data-hero-dim aria-hidden="true"></div>
  </div>
</section>

<style>
  .hero { position: relative; }

  :global(html.js-motion) .hero { height: 170svh; }

  .hero__pin {
    position: relative;
    height: 100svh;
    min-height: 36rem;
    overflow: hidden;
    background: var(--night);
  }

  :global(html.js-motion) .hero__pin { position: sticky; top: 0; }

  .hero__scene { position: absolute; inset: 0; }

  .hero__scene :global(picture) { display: contents; }

  .hero__scene :global(.hero__layer) {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: 50% 72%;
  }

  .hero__scene :global(.hero__cut) { z-index: 2; }

  .hero__name {
    position: absolute;
    left: 50%;
    top: 52%;
    z-index: 1;
    display: flex;
    gap: 0.14em;
    margin: 0;
    translate: -50% -100%;
    font: 850 min(17vw, 34svh)/0.78 var(--display);
    letter-spacing: -0.005em;
    text-transform: uppercase;
    white-space: nowrap;
    color: var(--paper);
  }

  .hero__word { display: block; overflow: hidden; padding-block: 0.02em; }
  .hero__word > span { display: block; }

  /* Portrait: the whole of him, the name stacked in the sky above. */
  @media (max-aspect-ratio: 4/5) {
    .hero__scene :global(.hero__layer) { object-position: 50% 100%; }
    .hero__name {
      flex-direction: column;
      gap: 0;
      top: 58%;
      font-size: min(33vw, 22svh);
      text-align: center;
    }
  }

  .hero__top,
  .hero__foot {
    position: absolute;
    left: var(--gutter);
    right: var(--gutter);
    z-index: 3;
    display: flex;
    justify-content: space-between;
    align-items: flex-end;
    gap: 1rem;
  }

  .hero__top { top: 1.5rem; align-items: center; }
  .hero__top p { margin: 0; color: var(--silver); }
  .hero__nav { display: flex; gap: 1.6rem; font-size: 0.92rem; }
  .hero__nav a { color: var(--silver); transition: color 250ms var(--ease-out); }
  .hero__nav a:hover { color: var(--paper); }

  .hero__foot { bottom: 1.6rem; }
  .hero__role { margin: 0; color: var(--paper); line-height: 1.7; }
  .hero__cue { color: var(--silver); transition: color 250ms var(--ease-out); }
  .hero__cue:hover { color: var(--paper); }

  /* Keeps the corner type legible over the photo. */
  .hero__pin::after {
    content: '';
    position: absolute;
    inset: 0;
    z-index: 2;
    pointer-events: none;
    background:
      linear-gradient(to bottom, rgb(11 12 14 / 0.55), transparent 16%),
      linear-gradient(to top, rgb(11 12 14 / 0.7), transparent 26%);
  }

  .hero__dim {
    position: absolute;
    inset: 0;
    z-index: 4;
    background: var(--night);
    opacity: 0;
    pointer-events: none;
  }
</style>
