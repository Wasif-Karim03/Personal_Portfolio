---
/**
 * Wasif, now: the opening frame, and the first shape the story's dots hold.
 *
 * With motion, the picture and the dots are drawn on the fixed stage
 * (src/components/story/Stage.astro), because the dots carry on past this
 * section: his name breaks apart here and gathers into the globe below, on the
 * same canvas. This section is the scroll that drives that, plus the type in
 * the corners. The heading stays in the page for screen readers, and is what
 * shows when the dots cannot be drawn.
 *
 * Without motion there is no stage, so the still lives here: the graded
 * photograph, him cut from it with its own matte, and his name set in type.
 */
import { Picture } from 'astro:assets';
import now from '../../assets/story/now.jpg';
import cutout from '../../assets/story/now-cutout.png';
---

<section class="hero" data-hero aria-labelledby="hero-name">
  <div class="hero__pin">
    <div class="hero__still">
      <Picture src={now} formats={['avif', 'webp']} widths={[900, 1400, 1800]} sizes="100vw" alt="" class="hero__layer" />
      <Picture src={cutout} formats={['avif', 'webp']} widths={[900, 1400, 1800]} sizes="100vw" alt="Wasif Karim smiling in a denim jacket on a rooftop in New York, black and white." class="hero__layer hero__cut" />
    </div>

    <h1 class="hero__name" id="hero-name">
      <span class="hero__word">Wasif</span>
      <span class="hero__word">Karim</span>
    </h1>

    <header class="hero__top" data-fade>
      <p class="mono hero__status"><span class="hero__dot" aria-hidden="true"></span>Open to robotics roles · 2026</p>
      <nav class="hero__nav" aria-label="Main">
        <span class="mono hero__clock" data-clock title="Local time in Cleveland">Cleveland</span>
        <a href="/work">Work</a>
        <a href="/contact">Contact</a>
      </nav>
    </header>

    <div class="hero__foot" data-fade>
      <p class="mono hero__role">Robotics software engineer<br />Cleveland, Ohio</p>
      <a class="mono hero__cue" href="#flight"><span class="hero__cue-line" aria-hidden="true"></span>The story, 2022 → now</a>
    </div>
  </div>
</section>

<script>
  import { ScrollTrigger, initMotion } from '../../lib/motion';
  import { openStage, setStage } from '../../lib/story-stage';

  const hero = document.querySelector<HTMLElement>('[data-hero]');

  if (hero && initMotion()) {
    // The name breaks up over the first part of the scroll, so the dots are
    // already travelling when the globe below starts to gather them.
    ScrollTrigger.create({
      trigger: hero,
      start: 'top top',
      end: 'bottom bottom',
      onUpdate: (self) => setStage({ scatter: Math.min(self.progress / 0.72, 1) }),
    });

    openStage().then((scene) => {
      // Only stand the heading down once the dots are actually drawing it.
      if (scene?.named) document.documentElement.classList.add('js-dots');
    });
  }
</script>

<script>
  // Wasif's local time, a small true detail in the corner.
  const clock = document.querySelector<HTMLElement>('[data-clock]');
  if (clock) {
    const format = new Intl.DateTimeFormat('en-US', { timeZone: 'America/New_York', hour: 'numeric', minute: '2-digit' });
    const tick = () => { clock.textContent = `Cleveland ${format.format(new Date())}`; };
    tick();
    setInterval(tick, 30_000);
  }
</script>

<style>
  .hero { position: relative; }

  :global(html.js-motion) .hero { height: 170svh; }

  .hero__pin {
    position: relative;
    height: 100svh;
    min-height: 36rem;
    overflow: hidden;
    background: var(--night);
  }

  /* With motion the stage behind the page holds the picture and the dots. */
  :global(html.js-motion) .hero__pin { position: sticky; top: 0; background: transparent; }
  :global(html.js-motion) .hero__still { display: none; }

  .hero__still { position: absolute; inset: 0; }
  .hero__still :global(picture) { display: contents; }

  .hero__still :global(.hero__layer) {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: 50% 72%;
  }

  .hero__still :global(.hero__cut) { z-index: 2; }

  .hero__name {
    position: absolute;
    left: 50%;
    top: 52%;
    z-index: 1;
    display: flex;
    gap: 0.14em;
    margin: 0;
    translate: -50% -100%;
    font: 850 min(17vw, 34svh)/0.78 var(--display);
    letter-spacing: -0.005em;
    text-transform: uppercase;
    white-space: nowrap;
    color: var(--paper);
    text-shadow: 0 0.02em 0.5em rgb(0 0 0 / 0.28);
  }

  .hero__word { display: block; }

  /* Once the dots draw the name, the heading stays only for screen readers. */
  :global(html.js-dots) .hero__name {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip: rect(0 0 0 0);
    white-space: nowrap;
  }

  /* Portrait: the whole of him, the name stacked in the sky above. */
  @media (max-aspect-ratio: 4/5) {
    .hero__still :global(.hero__layer) { object-position: 50% 100%; }
    .hero__name {
      flex-direction: column;
      gap: 0;
      top: 58%;
      font-size: min(33vw, 22svh);
      text-align: center;
    }
  }

  .hero__top,
  .hero__foot {
    position: absolute;
    left: var(--gutter);
    right: var(--gutter);
    z-index: 3;
    display: flex;
    justify-content: space-between;
    align-items: flex-end;
    gap: 1rem;
  }

  .hero__top { top: 1.5rem; align-items: center; }
  .hero__top p { margin: 0; color: var(--silver); }
  .hero__status { display: flex; align-items: center; gap: 0.6rem; color: var(--paper) !important; }
  .hero__dot { width: 6px; height: 6px; border-radius: 50%; background: #7ee2a8; box-shadow: 0 0 0 3px rgb(126 226 168 / 0.18); }
  .hero__nav { display: flex; align-items: center; gap: 1.6rem; font-size: 0.92rem; }
  .hero__clock { color: var(--silver); font-variant-numeric: tabular-nums; }
  @media (max-width: 47.99rem) { .hero__clock { display: none; } }
  .hero__nav a { color: var(--silver); transition: color 250ms var(--ease-out); }
  .hero__nav a:hover { color: var(--paper); }

  .hero__foot { bottom: 1.6rem; }
  .hero__role { margin: 0; color: var(--paper); line-height: 1.7; }
  .hero__cue { display: flex; align-items: center; gap: 0.8rem; color: var(--silver); transition: color 250ms var(--ease-out); }

  /* A short line that keeps travelling down: the one thing moving at rest. */
  .hero__cue-line { position: relative; width: 1px; height: 2.2rem; overflow: hidden; background: rgb(243 242 238 / 0.2); }
  .hero__cue-line::after { content: ''; position: absolute; inset: 0; background: var(--paper); translate: 0 -100%; animation: cue 2.2s var(--ease-out) infinite; }
  @keyframes cue { 0% { translate: 0 -100%; } 55%, 100% { translate: 0 100%; } }
  @media (prefers-reduced-motion: reduce) { .hero__cue-line::after { animation: none; translate: 0 0; } }
  .hero__cue:hover { color: var(--paper); }

  /* Keeps the corner type legible over the picture. */
  .hero__pin::after {
    content: '';
    position: absolute;
    inset: 0;
    z-index: 2;
    pointer-events: none;
    background:
      linear-gradient(to bottom, rgb(11 12 14 / 0.55), transparent 16%),
      linear-gradient(to top, rgb(11 12 14 / 0.7), transparent 26%);
  }
</style>
