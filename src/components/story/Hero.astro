---
/**
 * Wasif, now: a real photo of him (New York, May 2026) in black and white, with
 * his name set huge behind him. Three layers share one frame: the photo, the
 * name, then Wasif cut from the photo with its matte, so the name passes behind
 * his head. Nothing here is generated; the cut-out comes from the photo itself.
 *
 * The city behind him is graded darker and softly out of focus, as a portrait
 * lens would render it, so the name reads cleanly and he stands forward.
 *
 * The name is drawn as gaussian dots on its own canvas between the two picture
 * layers (src/lib/name-dots.ts), so it still passes behind his head. The dots
 * settle into the letters when the page opens, and as the opening scrolls away
 * they lift toward the globe that gathers next, carrying the story's dots from
 * one scene into the other. The heading itself stays in the page for screen
 * readers, and is shown instead of the dots where WebGL is missing.
 */
import { Picture } from 'astro:assets';
import now from '../../assets/story/now.jpg';
import cutout from '../../assets/story/now-cutout.png';
---

<section class="hero" data-hero aria-labelledby="hero-name">
  <div class="hero__pin" data-hero-pin>
    <div class="hero__scene" data-hero-scene>
      <Picture src={now} formats={['avif', 'webp']} widths={[900, 1400, 1800]} sizes="100vw" loading="eager" fetchpriority="high" alt="" class="hero__layer" />
      <canvas class="hero__dots" data-hero-dots aria-hidden="true"></canvas>
      <h1 class="hero__name" id="hero-name" data-hero-name>
        <span class="hero__word">Wasif</span>
        <span class="hero__word">Karim</span>
      </h1>
      <Picture src={cutout} formats={['avif', 'webp']} widths={[900, 1400, 1800]} sizes="100vw" loading="eager" alt="Wasif Karim smiling in a denim jacket on a rooftop in New York, black and white." class="hero__layer hero__cut" />
    </div>

    <header class="hero__top" data-fade>
      <p class="mono hero__status"><span class="hero__dot" aria-hidden="true"></span>Open to robotics roles · 2026</p>
      <nav class="hero__nav" aria-label="Main">
        <span class="mono hero__clock" data-clock title="Local time in Cleveland">Cleveland</span>
        <a href="/work">Work</a>
        <a href="/contact">Contact</a>
      </nav>
    </header>

    <div class="hero__foot" data-fade>
      <p class="mono hero__role">Robotics software engineer<br />Cleveland, Ohio</p>
      <a class="mono hero__cue" href="#prelude"><span class="hero__cue-line" aria-hidden="true"></span>The story, 2022 → now</a>
    </div>

    <div class="hero__dim" data-hero-dim aria-hidden="true"></div>
  </div>
</section>

<script>
  import { ScrollTrigger, initMotion } from '../../lib/motion';
  import type { NameDots } from '../../lib/name-dots';

  // The name as dots, and their flight out toward the globe.
  const hero = document.querySelector<HTMLElement>('[data-hero]');
  const dotsCanvas = hero?.querySelector<HTMLCanvasElement>('[data-hero-dots]');
  const webgl = () => {
    try { return Boolean(document.createElement('canvas').getContext('webgl2')); } catch { return false; }
  };

  if (hero && dotsCanvas && webgl() && initMotion()) {
    let dots: NameDots | null = null;
    let leaving = 0;
    let settled = false;

    const start = async () => {
      try {
        const face = "'Big Shoulders Display Variable', 'Arial Narrow', sans-serif";
        // The sampled letterforms are only his if the display face has arrived.
        await document.fonts.load(`850 100px ${face}`).catch(() => {});
        const [{ createNameDots }] = await Promise.all([import('../../lib/name-dots'), document.fonts.ready]);
        const portrait = window.matchMedia('(max-aspect-ratio: 4/5)').matches;
        const light = window.matchMedia('(max-width: 48rem)').matches;
        dots = createNameDots(
          dotsCanvas,
          { lines: portrait ? ['Wasif', 'Karim'] : ['Wasif Karim'], weight: 850, family: face },
          light ? 40000 : 110000,
        );
        if (!dots) return;
        hero.classList.add('is-dots');
        dots.setScroll(leaving);
        if (settled) dots.intro();
        window.addEventListener('resize', () => dots?.resize());
      } catch (error) {
        console.warn('name dots unavailable', error);
      }
    };

    document.addEventListener('story:reveal', () => {
      settled = true;
      dots?.intro();
    }, { once: true });

    ScrollTrigger.create({
      trigger: hero,
      start: 'top top',
      end: 'bottom bottom',
      onUpdate: (self) => {
        leaving = self.progress;
        dots?.setScroll(leaving);
      },
    });

    start();
  }
</script>

<script>
  // Wasif's local time, a small true detail in the corner.
  const clock = document.querySelector<HTMLElement>('[data-clock]');
  if (clock) {
    const format = new Intl.DateTimeFormat('en-US', { timeZone: 'America/New_York', hour: 'numeric', minute: '2-digit' });
    const tick = () => { clock.textContent = `Cleveland ${format.format(new Date())}`; };
    tick();
    setInterval(tick, 30_000);
  }
</script>

<style>
  .hero { position: relative; }

  :global(html.js-motion) .hero { height: 170svh; }

  .hero__pin {
    position: relative;
    height: 100svh;
    min-height: 36rem;
    overflow: hidden;
    background: var(--night);
  }

  :global(html.js-motion) .hero__pin { position: sticky; top: 0; }

  .hero__scene { position: absolute; inset: 0; }

  .hero__scene :global(picture) { display: contents; }

  .hero__scene :global(.hero__layer) {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: 50% 72%;
  }

  .hero__scene :global(.hero__cut) { z-index: 2; }

  .hero__dots {
    position: absolute;
    inset: 0;
    z-index: 1;
    width: 100%;
    height: 100%;
  }

  /* Once the dots draw the name, the heading stays only for screen readers. */
  .hero.is-dots .hero__name {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip: rect(0 0 0 0);
    white-space: nowrap;
  }

  .hero__name {
    position: absolute;
    left: 50%;
    top: 52%;
    z-index: 1;
    display: flex;
    gap: 0.14em;
    margin: 0;
    translate: -50% -100%;
    font: 850 min(17vw, 34svh)/0.78 var(--display);
    letter-spacing: -0.005em;
    text-transform: uppercase;
    white-space: nowrap;
    color: var(--paper);
    text-shadow: 0 0.02em 0.5em rgb(0 0 0 / 0.28);
  }

  .hero__word { display: block; }

  /* Portrait: the whole of him, the name stacked in the sky above. */
  @media (max-aspect-ratio: 4/5) {
    .hero__scene :global(.hero__layer) { object-position: 50% 100%; }
    .hero__name {
      flex-direction: column;
      gap: 0;
      top: 58%;
      font-size: min(33vw, 22svh);
      text-align: center;
    }
  }

  .hero__top,
  .hero__foot {
    position: absolute;
    left: var(--gutter);
    right: var(--gutter);
    z-index: 3;
    display: flex;
    justify-content: space-between;
    align-items: flex-end;
    gap: 1rem;
  }

  .hero__top { top: 1.5rem; align-items: center; }
  .hero__top p { margin: 0; color: var(--silver); }
  .hero__status { display: flex; align-items: center; gap: 0.6rem; color: var(--paper) !important; }
  .hero__dot { width: 6px; height: 6px; border-radius: 50%; background: #7ee2a8; box-shadow: 0 0 0 3px rgb(126 226 168 / 0.18); }
  .hero__nav { display: flex; align-items: center; gap: 1.6rem; font-size: 0.92rem; }
  .hero__clock { color: var(--silver); font-variant-numeric: tabular-nums; }
  @media (max-width: 47.99rem) { .hero__clock { display: none; } }
  .hero__nav a { color: var(--silver); transition: color 250ms var(--ease-out); }
  .hero__nav a:hover { color: var(--paper); }

  .hero__foot { bottom: 1.6rem; }
  .hero__role { margin: 0; color: var(--paper); line-height: 1.7; }
  .hero__cue { display: flex; align-items: center; gap: 0.8rem; color: var(--silver); transition: color 250ms var(--ease-out); }

  /* A short line that keeps travelling down: the one thing moving at rest. */
  .hero__cue-line { position: relative; width: 1px; height: 2.2rem; overflow: hidden; background: rgb(243 242 238 / 0.2); }
  .hero__cue-line::after { content: ''; position: absolute; inset: 0; background: var(--paper); translate: 0 -100%; animation: cue 2.2s var(--ease-out) infinite; }
  @keyframes cue { 0% { translate: 0 -100%; } 55%, 100% { translate: 0 100%; } }
  @media (prefers-reduced-motion: reduce) { .hero__cue-line::after { animation: none; translate: 0 0; } }
  .hero__cue:hover { color: var(--paper); }

  /* Keeps the corner type legible over the photo. */
  .hero__pin::after {
    content: '';
    position: absolute;
    inset: 0;
    z-index: 2;
    pointer-events: none;
    background:
      linear-gradient(to bottom, rgb(11 12 14 / 0.55), transparent 16%),
      linear-gradient(to top, rgb(11 12 14 / 0.7), transparent 26%);
  }

  .hero__dim {
    position: absolute;
    inset: 0;
    z-index: 4;
    background: var(--night);
    opacity: 0;
    pointer-events: none;
  }
</style>
