---
/**
 * The prologue: the line that starts the story, and beside it the globe where
 * the 2022 flight from Dhaka to Ohio draws itself as you scroll. The section
 * holds still while the flight happens. Every fact is from the resume and the
 * storyboard.
 */
import FlightGlobe from './FlightGlobe.astro';
---

<section class="prelude" id="prelude" data-prelude aria-label="Prologue">
  <div class="prelude__pin">
    <p class="prelude__line" data-lines>
      In August 2022, I left Dhaka for a small college in Ohio to study the stars and the code behind machines. <em>This is what happened next.</em>
    </p>
    <div class="prelude__globe">
      <FlightGlobe />
    </div>
  </div>
</section>

<style>
  .prelude { position: relative; }

  :global(html.js-motion) .prelude { height: 280svh; }

  .prelude__pin {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1.05fr);
    align-items: center;
    gap: clamp(1.5rem, 4vw, 4rem);
    min-height: 100svh;
    padding-block: 5rem;
    padding-inline: var(--gutter) calc(var(--gutter) + 6.5rem);
  }

  :global(html.js-motion) .prelude__pin { position: sticky; top: 0; height: 100svh; }

  .prelude__line {
    margin: 0;
    max-width: 21ch;
    font: 400 clamp(2.1rem, 1.2rem + 3vw, 4.4rem)/1.06 var(--serif);
    letter-spacing: -0.012em;
    text-wrap: balance;
  }

  .prelude__line em { color: var(--silver); }

  @media (max-width: 47.99rem) {
    .prelude__pin {
      grid-template-columns: 1fr;
      align-content: center;
      gap: 1.5rem;
      padding-inline: var(--gutter);
      padding-block: 4rem 3rem;
    }

    .prelude__globe { order: -1; }

    .prelude__line { font-size: clamp(1.7rem, 1.2rem + 2.4vw, 2.3rem); }
  }
</style>
