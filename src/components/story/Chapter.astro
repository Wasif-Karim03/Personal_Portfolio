---
/**
 * One chapter of the journey: the year huge, a place and date, a title and one
 * line, and a single wide film frame that opens as the chapter scrolls in.
 */
import { Picture } from 'astro:assets';
import type { ImageMetadata } from 'astro';

interface Props {
  id: string;
  number: string;
  year: string;
  place: string;
  title: string;
  line: string;
  image: ImageMetadata;
  alt: string;
}

const { id, number, year, place, title, line, image, alt } = Astro.props;
---

<section class="chapter" id={id} data-chapter data-year={year} aria-labelledby={`${id}-title`}>
  <div class="chapter__pin" data-chapter-pin>
    <p class="chapter__year" aria-hidden="true" data-year-text>{year}</p>

    <div class="chapter__frame" data-frame>
      <Picture src={image} formats={['avif', 'webp']} widths={[900, 1600, 2400]} sizes="100vw" alt={alt} class="chapter__img" />
    </div>

    <div class="chapter__text">
      <p class="mono chapter__meta">Chapter {number} · {place}</p>
      <h2 class="chapter__title" id={`${id}-title`} data-lines>{title}</h2>
      <p class="chapter__line" data-lines>{line}</p>
    </div>
  </div>
</section>

<style>
  .chapter { position: relative; }

  :global(html.js-motion) .chapter { height: 220svh; }

  .chapter__pin {
    position: relative;
    height: 100svh;
    min-height: 36rem;
    overflow: hidden;
  }

  :global(html.js-motion) .chapter__pin { position: sticky; top: 0; }

  /* The year sits behind everything, set like a title card. */
  .chapter__year {
    position: absolute;
    left: 50%;
    top: 50%;
    z-index: 0;
    margin: 0;
    translate: -50% -52%;
    font: 850 min(46vw, 78svh)/0.8 var(--display);
    letter-spacing: -0.02em;
    color: var(--ink);
    -webkit-text-stroke: 1px rgb(243 242 238 / 0.18);
    white-space: nowrap;
    user-select: none;
  }

  .chapter__frame {
    position: absolute;
    inset: 0;
    z-index: 1;
    overflow: hidden;
  }

  .chapter__frame :global(picture) { display: contents; }

  .chapter__frame :global(.chapter__img) {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .chapter__frame::after {
    content: '';
    position: absolute;
    inset: 0;
    background: linear-gradient(to top, rgb(11 12 14 / 0.88), transparent 55%);
  }

  .chapter__text {
    position: absolute;
    left: var(--gutter);
    right: var(--gutter);
    bottom: clamp(2rem, 8svh, 5rem);
    z-index: 2;
    display: grid;
    gap: 0.9rem;
    max-width: 44rem;
  }

  .chapter__meta { margin: 0; color: var(--silver); }

  .chapter__title {
    margin: 0;
    font: 400 clamp(3rem, 1.6rem + 5vw, 6.4rem)/0.95 var(--serif);
    letter-spacing: -0.015em;
  }

  .chapter__line {
    margin: 0;
    max-width: 34ch;
    font-size: clamp(1.02rem, 0.95rem + 0.3vw, 1.2rem);
    color: var(--silver);
  }
</style>
