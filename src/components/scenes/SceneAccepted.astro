---
/**
 * FIG. 03 — Accepted · 2022.
 *
 * The point cloud draws the acceptance letter ("letter" in
 * src/lib/cloud-shapes.ts): a sheet with the university's name, and blocks for
 * lines of text, the two that matter in orange. This is what those lines say.
 * The cloud is a drawing, not a copy: no logo, no signature, no invented
 * wording.
 */
const lines = [
  { text: 'Ohio Wesleyan University', where: 'The letterhead' },
  { text: 'Computer Science + Astrophysics', where: 'First orange line' },
  { text: 'Schubert Scholarship', where: 'Second orange line' },
];
---

<ol class="legend">
  {
    lines.map(({ text, where }, index) => (
      <li class="legend__item">
        <span class="legend__n" aria-hidden="true">
          {index + 1}
        </span>
        <span class="legend__text">
          {text}
          <span class="legend__where label">{where}</span>
        </span>
      </li>
    ))
  }
</ol>

<style>
  .legend {
    display: grid;
    gap: var(--space-m);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .legend__item {
    display: grid;
    grid-template-columns: 2rem 1fr;
    align-items: start;
    gap: var(--space-s);
    font-family: var(--font-display);
    font-stretch: var(--stretch-display);
    font-weight: 700;
    font-size: var(--step-2);
    line-height: 1.1;
  }

  .legend__text {
    display: grid;
    gap: var(--space-3xs);
  }

  .legend__where {
    color: var(--ink-60);
    font-stretch: normal;
    font-weight: 400;
  }

  .legend__n {
    display: grid;
    place-items: center;
    width: 1.9rem;
    height: 1.9rem;
    border: 1.5px solid var(--ink);
    border-radius: 50%;
    font-family: var(--font-mono);
    font-stretch: normal;
    font-weight: 400;
    font-size: var(--step--1);
  }
</style>
