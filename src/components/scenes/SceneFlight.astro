---
/**
 * FIG. 04 — The flight · 10 AUG 2022.
 *
 * The point cloud becomes the globe ("globe", built by scripts/make-clouds.mjs
 * from Natural Earth) and an orange route draws from Bangladesh to Ohio as the
 * scene scrolls. This is the readout beside it: the position and distance tick
 * along with the route, and land on Delaware, OH.
 *
 * The scene is a tall scroll track so the route has room to draw. Without
 * script, or under reduced motion, the readout shows the landing and the cloud
 * shows the whole route. Script only follows the scroll, never drives it.
 */
import { flight } from '../../data/flight';
import { formatCoordinates, kilometres } from '../../lib/geo-format';

const km = kilometres.format(flight.distanceKm);

const config = JSON.stringify({
  samples: flight.samples.map(([, , lat, lon]) => [lat, lon]),
  distanceKm: flight.distanceKm,
});
---

<div class="flight" data-scene-flight data-config={config}>
  <div class="flight__stage">
    <p class="flight__route label">{flight.origin.label} → {flight.destination.label}</p>
    <dl class="readout">
      <div>
        <dt class="label">Position</dt>
        <dd data-position>
          {formatCoordinates(flight.destination.lat, flight.destination.lon)}
        </dd>
      </div>
      <div>
        <dt class="label">Flown</dt>
        <dd data-flown>{km} km of {km} km</dd>
      </div>
      <div>
        <dt class="label">Route</dt>
        <dd class="readout__note">
          Great circle: the shortest path over the globe, not the flights taken.
        </dd>
      </div>
    </dl>
  </div>
</div>

<style>
  .flight {
    position: relative;
    height: 180svh;
  }

  .flight__stage {
    position: sticky;
    inset-block-start: 30svh;
    display: grid;
    gap: var(--space-m);
  }

  /* Clear of the cloud panel on narrow screens. */
  @media (max-width: 59.99rem) {
    .flight__stage {
      inset-block-start: calc(46svh + var(--space-m));
    }
  }

  .flight__route {
    color: var(--signal-text);
  }

  .readout {
    display: grid;
    gap: var(--space-xs);
    width: 100%;
    max-width: 26rem;
    margin: 0;
  }

  .readout > div {
    display: grid;
    grid-template-columns: 5.5rem 1fr;
    align-items: baseline;
    gap: var(--space-s);
    padding-block-end: var(--space-2xs);
    border-block-end: var(--rule) solid var(--rule-colour);
  }

  .readout dd {
    margin: 0;
    font-family: var(--font-mono);
  }

  .readout__note {
    font-size: var(--step--1);
    color: var(--ink-60);
  }

  @media (prefers-reduced-motion: reduce) {
    .flight {
      height: auto;
    }

    .flight__stage {
      position: static;
    }
  }
</style>

<script>
  import { ScrollTrigger, scene } from '../../lib/motion';
  import { sceneProgress } from '../../lib/scene-progress';
  import { formatCoordinates, kilometres } from '../../lib/geo-format';

  interface FlightConfig {
    samples: Array<[lat: number, lon: number]>;
    distanceKm: number;
  }

  for (const root of document.querySelectorAll<HTMLElement>('[data-scene-flight]')) {
    scene(root, () => {
      const position = root.querySelector<HTMLElement>('[data-position]');
      const flown = root.querySelector<HTMLElement>('[data-flown]');
      const config = root.dataset.config;
      // Measured the way the cloud measures it, so numbers and route agree.
      const section = root.closest<HTMLElement>('[data-cloud]') ?? root;
      if (!position || !flown || !config) return;

      const { samples, distanceKm } = JSON.parse(config) as FlightConfig;
      const totalKm = kilometres.format(distanceKm);

      const render = () => {
        const p = sceneProgress(section.getBoundingClientRect());
        const [lat, lon] = samples[Math.round(p * (samples.length - 1))];
        position.textContent = formatCoordinates(lat, lon);
        flown.textContent = `${kilometres.format(Math.round(distanceKm * p))} km of ${totalKm} km`;
      };

      ScrollTrigger.create({ trigger: section, start: 'top bottom', end: 'bottom top', onUpdate: render });
      render();
    });
  }
</script>
