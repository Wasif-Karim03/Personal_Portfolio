---
/**
 * FIG. 15 — Resume.
 *
 * The point cloud draws the resume as a sheet ("resume" in
 * src/lib/cloud-shapes.ts), the download mark in orange. This is the download
 * itself, boxed the way the robot-vision layer boxes a detection.
 */
const pdf = '/Resume_WasifKarim.pdf';
---

<div class="resume">
  <a class="sheet-link" href={pdf} download>
    <span class="sheet-link__tag" aria-hidden="true">resume.pdf</span>
    <span class="sheet-link__label">Download resume</span>
    <span class="sheet-link__meta label">PDF · 1 page</span>
  </a>
</div>

<style>
  .resume {
    padding-block-start: var(--space-m);
  }

  .sheet-link {
    position: relative;
    display: inline-grid;
    gap: var(--space-3xs);
    padding: var(--space-m) var(--space-l);
    color: var(--ink);
    text-decoration: none;
    border: 3px solid var(--signal);
    background: var(--paper);
    transition: background-color var(--dur-base) var(--ease-out);
  }

  .sheet-link:hover {
    color: var(--ink);
    background: var(--signal-12);
  }

  .sheet-link:focus-visible {
    outline: 3px solid var(--ink);
    outline-offset: 3px;
  }

  /* Like a detection's class tag, sitting on the box's top edge. Ink on orange. */
  .sheet-link__tag {
    position: absolute;
    bottom: 100%;
    left: -3px;
    padding: 0.1rem 0.4rem;
    background: var(--signal);
    color: var(--ink);
    font-family: var(--font-mono);
    font-size: 0.72rem;
  }

  .sheet-link__label {
    font-family: var(--font-display);
    font-stretch: var(--stretch-display);
    font-weight: 700;
    font-size: var(--step-3);
    line-height: 1;
  }
</style>
