---
/**
 * FIG. 16 — Contact.
 *
 * An email-compose window that really sends.
 *
 * It is a plain <form> that POSTs to Formspree, so it works with JavaScript
 * switched off. Script only upgrades it to submit in place and show the result
 * without a page change.
 *
 * Until PUBLIC_FORMSPREE_ENDPOINT is set it degrades to a mailto: link rather
 * than presenting a form that silently goes nowhere.
 */

interface Props {
  /** Keeps input ids unique if this is ever rendered twice on one page. */
  idPrefix?: string;
}

const { idPrefix = 'contact' } = Astro.props;

const endpoint = import.meta.env.PUBLIC_FORMSPREE_ENDPOINT;
const email = 'mdwasifkarim2003@gmail.com';
---

<div class="compose" data-scene-contact>
  <div class="win">
    <p class="win__chrome label">New message</p>

    {
      endpoint ? (
        <form
          class="win__body"
          method="POST"
          action={endpoint}
          data-contact-form
          novalidate
        >
          <div class="field field--fixed">
            <span class="field__key label">To</span>
            <span class="field__value">Wasif Karim</span>
          </div>

          <div class="field">
            <label class="field__key label" for={`${idPrefix}-email`}>
              From
            </label>
            <input
              class="field__input"
              id={`${idPrefix}-email`}
              type="email"
              name="email"
              autocomplete="email"
              required
              placeholder="you@example.com"
            />
          </div>

          <div class="field">
            <label class="field__key label" for={`${idPrefix}-subject`}>
              Subject
            </label>
            <input
              class="field__input"
              id={`${idPrefix}-subject`}
              type="text"
              name="subject"
              required
              placeholder="Saying hello"
            />
          </div>

          <div class="field field--body">
            <label class="field__key label" for={`${idPrefix}-message`}>
              Message
            </label>
            <textarea
              class="field__input field__input--area"
              id={`${idPrefix}-message`}
              name="message"
              rows="5"
              required
              placeholder="…"
            />
          </div>

          {/* Formspree's honeypot. Hidden from people, catches naive bots. */}
          <input
            class="gotcha"
            type="text"
            name="_gotcha"
            tabindex="-1"
            autocomplete="off"
            aria-hidden="true"
          />

          <div class="win__foot">
            <button class="send" type="submit" data-contact-submit>Send</button>
            <p class="status label" role="status" data-contact-status />
          </div>
        </form>
      ) : (
        <div class="win__body">
          <div class="field field--fixed">
            <span class="field__key label">To</span>
            <span class="field__value">Wasif Karim</span>
          </div>
          <p class="fallback">
            The send endpoint is not configured yet, so this composes in your own
            mail app instead.
          </p>
          <div class="win__foot">
            <a class="send" href={`mailto:${email}`}>
              Compose email
            </a>
          </div>
        </div>
      )
    }
  </div>

  <p class="plain">
    Or plainly: <a href={`mailto:${email}`}>{email}</a>
  </p>
</div>

<style>
  .compose {
    display: flex;
    flex-direction: column;
    gap: var(--space-m);
  }

  .win {
    width: 100%;
    max-width: 34rem;
    border: var(--rule) solid var(--ink);
  }

  .win__chrome {
    padding: var(--space-2xs) var(--space-s);
    border-block-end: var(--rule) solid var(--rule-colour);
    color: var(--ink-60);
  }

  .win__body {
    display: flex;
    flex-direction: column;
  }

  .field {
    display: grid;
    grid-template-columns: 5rem 1fr;
    align-items: baseline;
    gap: var(--space-2xs);
    padding: var(--space-2xs) var(--space-s);
    border-block-end: var(--rule) solid var(--rule-colour);
  }

  .field__key {
    color: var(--ink-60);
  }

  .field--body {
    align-items: start;
  }

  .field__input {
    width: 100%;
    padding: 0;
    background: none;
    border: none;
    font-family: var(--font-body);
  }

  .field__input::placeholder {
    color: var(--ink-60);
  }

  .field__input:focus {
    outline: none;
  }

  /* The field row lights up rather than a ring around the bare input. */
  .field:focus-within {
    background: var(--signal-12);
  }

  .field__input--area {
    resize: vertical;
    line-height: 1.5;
  }

  .gotcha {
    position: absolute;
    left: -9999px;
    width: 1px;
    height: 1px;
    opacity: 0;
  }

  .win__foot {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-s);
    padding: var(--space-s);
  }

  .send {
    padding: var(--space-2xs) var(--space-m);
    background: var(--ink);
    color: var(--paper);
    border: none;
    font-family: var(--font-mono);
    font-size: var(--step--1);
    letter-spacing: 0.08em;
    text-transform: uppercase;
    text-decoration: none;
    cursor: pointer;
  }

  .send:hover {
    background: var(--signal);
    color: var(--ink);
  }

  .send[disabled] {
    background: var(--ink-30);
    cursor: default;
  }

  .status:empty {
    display: none;
  }

  .status[data-state='error'] {
    color: var(--signal-text);
  }

  .fallback {
    padding: var(--space-s);
    color: var(--ink-60);
  }

  .plain {
    color: var(--ink-60);
  }
</style>

<script>
  const form = document.querySelector<HTMLFormElement>('[data-contact-form]');

  if (form) {
    const button = form.querySelector<HTMLButtonElement>('[data-contact-submit]');
    const status = form.querySelector<HTMLElement>('[data-contact-status]');

    const setStatus = (text: string, state: 'ok' | 'error' | '') => {
      if (!status) return;
      status.textContent = text;
      if (state) status.dataset.state = state;
      else delete status.dataset.state;
    };

    form.addEventListener('submit', async (event) => {
      // The form posts natively if anything here throws before this point, so
      // only take over once we know we can handle it.
      event.preventDefault();

      if (!form.checkValidity()) {
        form.reportValidity();
        return;
      }

      button?.setAttribute('disabled', '');
      setStatus('Sending…', '');

      try {
        const response = await fetch(form.action, {
          method: 'POST',
          body: new FormData(form),
          headers: { Accept: 'application/json' },
        });

        if (!response.ok) throw new Error(`HTTP ${response.status}`);

        form.reset();
        setStatus('Sent. I will get back to you.', 'ok');
      } catch {
        // Never swallow it: the visitor needs a route that still works.
        setStatus('That did not send. Email me directly instead.', 'error');
      } finally {
        button?.removeAttribute('disabled');
      }
    });
  }
</script>
