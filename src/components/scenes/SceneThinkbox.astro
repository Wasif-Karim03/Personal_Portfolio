---
/**
 * FIG. 12 — think[box] · 2026.
 *
 * The point cloud draws the volumetric printer ("printer" in
 * src/lib/cloud-shapes.ts): a part cures inside the turning vial as the scene
 * scrolls past, all at once, as the real printer cures it. The role and both
 * descriptions are from the resume.
 */
const projects = [
  {
    title: 'Volumetric resin printer',
    text: 'Control software for a prototype, with UC Berkeley, that cures a whole part in one rotation of the resin instead of layer by layer.',
  },
  {
    title: 'Poetry Camera',
    text: 'An open-source AI camera, moving from a cloud model to one that runs on the camera itself.',
  },
];
---

<div class="thinkbox">
  <p class="thinkbox__role label">Robotics Software Engineer · Case Western Reserve University · since June 2026</p>

  {
    projects.map(({ title, text }) => (
      <div class="project">
        <p class="project__title">{title}</p>
        <p class="project__text">{text}</p>
      </div>
    ))
  }
</div>

<style>
  .thinkbox {
    display: grid;
    gap: var(--space-l);
  }

  .thinkbox__role {
    color: var(--ink-60);
  }

  .project {
    display: grid;
    gap: var(--space-2xs);
  }

  .project__title {
    font-family: var(--font-display);
    font-stretch: var(--stretch-display);
    font-weight: 700;
    font-size: var(--step-2);
    line-height: 1.1;
  }

  .project__text {
    max-width: 44ch;
    color: var(--ink-60);
  }
</style>
