---
/**
 * FIG. 02 — Rewind.
 *
 * The point cloud winds into a spiral ("rewind" in src/lib/cloud-shapes.ts)
 * while a timecode spins from the present back to 10 August 2022, the day of
 * the flight in FIG. 04, where the story restarts.
 *
 * Without script, or under reduced motion, the timecode rests on 10 August
 * 2022. Script follows the scroll through the scene; it never drives it.
 */
import { timecode } from '../../lib/timecode';

// "Now" is when the site was built, so the rewind always starts from the present.
const from = Date.now();
const to = Date.UTC(2022, 7, 10);
const rested = timecode(to, 0);
const fromYear = new Date(from).getUTCFullYear();
---

<div class="rewind" data-scene-rewind data-from={from} data-to={to}>
  <div class="timecode" role="img" aria-label={`A timecode rewinding from ${fromYear} to 10 August 2022`}>
    <span class="timecode__day" data-day aria-hidden="true">{rested.day}</span>
    <span class="timecode__clock" data-clock aria-hidden="true">{rested.clock}</span>
  </div>
</div>

<style>
  .rewind {
    height: 140svh;
  }

  .timecode {
    position: sticky;
    inset-block-start: 35svh;
    display: grid;
    justify-items: start;
    gap: var(--space-2xs);
  }

  /* Clear of the cloud panel on narrow screens. */
  @media (max-width: 59.99rem) {
    .timecode {
      inset-block-start: calc(46svh + var(--space-m));
    }
  }

  .timecode__day {
    font-family: var(--font-display);
    font-stretch: var(--stretch-display);
    font-weight: 700;
    font-size: var(--step-5);
    line-height: 1.1;
    font-variant-numeric: tabular-nums;
  }

  .timecode__clock {
    font-family: var(--font-mono);
    font-size: var(--step--1);
    letter-spacing: 0.08em;
    color: var(--ink-60);
    font-variant-numeric: tabular-nums;
  }

  @media (prefers-reduced-motion: reduce) {
    .rewind {
      height: auto;
    }

    .timecode {
      position: static;
    }
  }
</style>

<script>
  import { ScrollTrigger, scene } from '../../lib/motion';
  import { sceneProgress } from '../../lib/scene-progress';
  import { TIMECODE_FPS, timecode } from '../../lib/timecode';

  /**
   * Frames the counter runs through across the whole rewind: twenty seconds'
   * worth, so it reads as a counter spinning rather than a date being picked.
   */
  const SPIN = TIMECODE_FPS * 20;

  for (const root of document.querySelectorAll<HTMLElement>('[data-scene-rewind]')) {
    scene(root, () => {
      const day = root.querySelector<HTMLElement>('[data-day]');
      const clock = root.querySelector<HTMLElement>('[data-clock]');
      const section = root.closest<HTMLElement>('[data-cloud]') ?? root;
      const from = Number(root.dataset.from);
      const to = Number(root.dataset.to);
      if (!day || !clock) return;

      const render = () => {
        const p = sceneProgress(section.getBoundingClientRect());
        const stamp = timecode(from + (to - from) * p, Math.floor(p * SPIN));
        day.textContent = stamp.day;
        clock.textContent = stamp.clock;
      };

      ScrollTrigger.create({ trigger: section, start: 'top bottom', end: 'bottom top', onUpdate: render });
      render();
    });
  }
</script>
