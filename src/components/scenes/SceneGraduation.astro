---
/**
 * FIG. 11 — Graduation · May 2026.
 *
 * A quiet, held moment: one real photo, and the degree set out as a drawing's
 * title block. Deliberately no motion. Every line is from the resume.
 */
import MediaFrame from '../MediaFrame.astro';

const rows: Array<[label: string, value: string]> = [
  ['Institution', 'Ohio Wesleyan University'],
  ['Degree', 'B.S. Astrophysics'],
  ['Degree', 'B.A. Computer Science'],
  ['GPA', '3.82'],
  ['Distinction', 'Honors'],
  ['Date', 'May 2026'],
];
---

<div class="graduation">
  <MediaFrame id="graduation" sizes="(min-width: 60rem) 40vw, 100vw" />

  <dl class="titleblock">
    {
      rows.map(([label, value]) => (
        <div class="titleblock__row">
          <dt class="label">{label}</dt>
          <dd>{value}</dd>
        </div>
      ))
    }
  </dl>
</div>

<style>
  .graduation {
    display: grid;
    gap: var(--space-l);
    align-items: end;
    max-width: 60rem;
  }

  .titleblock {
    margin: 0;
    border: 1.5px solid var(--ink);
  }

  .titleblock__row {
    display: grid;
    grid-template-columns: 8rem 1fr;
    align-items: baseline;
    gap: var(--space-s);
    padding: var(--space-2xs) var(--space-s);
  }

  .titleblock__row + .titleblock__row {
    border-block-start: var(--rule) solid var(--rule-colour);
  }

  .titleblock dd {
    margin: 0;
    font-family: var(--font-display);
    font-stretch: var(--stretch-display);
    font-weight: 700;
    font-size: var(--step-1);
  }

  @media (min-width: 60rem) {
    .graduation {
      grid-template-columns: minmax(0, 5fr) minmax(0, 4fr);
    }
  }
</style>
