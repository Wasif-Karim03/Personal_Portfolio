---
/**
 * FIG. 11 — Graduation · May 2026.
 *
 * A quiet, held moment: the point cloud holds a portrait built from the
 * graduation photo, and the degree is set out as a drawing's title block.
 * Deliberately no motion here. Every line is from the resume.
 */
const rows: Array<[label: string, value: string]> = [
  ['Institution', 'Ohio Wesleyan University'],
  ['Degree', 'B.S. Astrophysics'],
  ['Degree', 'B.A. Computer Science'],
  ['GPA', '3.82'],
  ['Distinction', 'Honors'],
  ['Date', 'May 2026'],
];
---

<dl class="titleblock">
  {
    rows.map(([label, value]) => (
      <div class="titleblock__row">
        <dt class="label">{label}</dt>
        <dd>{value}</dd>
      </div>
    ))
  }
</dl>

<style>
  .titleblock {
    max-width: 30rem;
    margin: 0;
    border: 1.5px solid var(--ink);
    background: var(--paper);
  }

  .titleblock__row {
    display: grid;
    grid-template-columns: 8rem 1fr;
    align-items: baseline;
    gap: var(--space-s);
    padding: var(--space-2xs) var(--space-s);
  }

  .titleblock__row + .titleblock__row {
    border-block-start: var(--rule) solid var(--rule-colour);
  }

  .titleblock dd {
    margin: 0;
    font-family: var(--font-display);
    font-stretch: var(--stretch-display);
    font-weight: 700;
    font-size: var(--step-1);
  }
</style>
