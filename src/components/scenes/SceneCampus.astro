---
/**
 * FIG. 05 — Ohio Wesleyan · 2022–26.
 *
 * The point cloud builds the university's student observatory ("observatory"
 * in src/lib/cloud-shapes.ts), for the astrophysics half of the degree. This is
 * the degree and one line of coursework, both from the resume.
 */
const courses = [
  'Data Structures & Algorithms',
  'Databases',
  'Software Engineering',
  'Machine Learning',
  'Computer Vision',
  'NLP',
  'Numerical Methods',
];
---

<div class="campus">
  <p class="campus__degree">B.S. Astrophysics · B.A. Computer Science</p>
  <p class="campus__courses label">{courses.join(' · ')}</p>
  <p class="campus__drawn label">In points: the Ohio Wesleyan student observatory</p>
</div>

<style>
  .campus {
    display: grid;
    gap: var(--space-m);
  }

  .campus__degree {
    font-family: var(--font-display);
    font-stretch: var(--stretch-display);
    font-weight: 700;
    font-size: var(--step-2);
  }

  .campus__courses {
    max-width: var(--measure);
    line-height: 1.8;
  }

  .campus__drawn {
    color: var(--ink-60);
  }
</style>
