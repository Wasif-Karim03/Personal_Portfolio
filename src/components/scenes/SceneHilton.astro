---
/**
 * FIG. 08 — Summer 2024 · Hilton.
 *
 * The point cloud draws the shape of the system ("api" in
 * src/lib/cloud-shapes.ts): an app, an endpoint, a PostgreSQL database, and the
 * request between them in orange.
 *
 * No internal screens or logos, per the rule in CLAUDE.md: a shape of system
 * drawn from scratch, not a picture of Hilton's software.
 */

const facts = [
  { value: '6', label: 'REST endpoints' },
  { value: '1', label: 'Tableau dashboard' },
  { value: 'CI/CD', label: 'pipeline' },
];
---

<div class="hilton">
  <p class="hilton__role label">Software Engineering Intern · Summer 2024</p>

  <p class="hilton__path">
    App <span aria-hidden="true">→</span><span class="sr-only">to</span> /api/…
    <span aria-hidden="true">→</span><span class="sr-only">to</span> PostgreSQL
  </p>

  <dl class="facts">
    {
      facts.map(({ value, label }) => (
        <div class="fact">
          <dt class="fact__value">{value}</dt>
          <dd class="fact__label label">{label}</dd>
        </div>
      ))
    }
  </dl>
</div>

<style>
  .hilton {
    display: flex;
    flex-direction: column;
    gap: var(--space-m);
  }

  .hilton__role {
    color: var(--ink-60);
  }

  .hilton__path {
    font-family: var(--font-mono);
    font-size: var(--step-1);
  }

  .facts {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-l);
    margin: 0;
  }

  .fact__value {
    font-family: var(--font-display);
    font-stretch: var(--stretch-display);
    font-size: var(--step-3);
    line-height: 1;
  }

  .fact__label {
    margin: var(--space-3xs) 0 0;
  }
</style>
